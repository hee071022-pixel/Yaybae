{
  "format_version": "1.8.0",
  "animations": {
    "animation.mdv.projectile.orient": {
      "loop": true,
      "bones": {
        "body": {
          "rotation": [
            "-q.target_x_rotation",
            "-q.target_y_rotation",
            0
          ]
        }
      }
    },
    "animation.mdv.projectile.tumble": {
      "loop": true,
      "bones": {
        "body": {
          "rotation": [
            "q.life_time * 720",
            "q.life_time * 240",
            0
          ]
        }
      }
    },
    "animation.mdv.projectile.trail": {
      "loop": true,
      "animation_length": 0.1,
      "particle_effects": {
        "0.0": {
          "effect": "trail"
        }
      }
    },
    "animation.mdv.projectile.fire_trail": {
      "loop": true,
      "animation_length": 0.1,
      "particle_effects": {
        "0.0": {
          "effect": "trail"
        },
        "0.05": {
          "effect": "smoke"
        }
      }
    }
  }
}
