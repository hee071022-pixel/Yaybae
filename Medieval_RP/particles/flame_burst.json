{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "mdv:flame_burst",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/mdv_fx"
      }
    },
    "components": {
