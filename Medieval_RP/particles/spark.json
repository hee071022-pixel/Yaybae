{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "mdv:spark",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/mdv_fx"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 14
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.3, 0.6)"
      },
      "minecraft:particle_initial_speed": "math.random(3, 6)",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          -14,
          0
        ],
        "linear_drag_coefficient": 1.5
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.08 * (1 - v.particle_age / v.particle_lifetime)",
          "0.08 * (1 - v.particle_age / v.particle_lifetime)"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 64,
          "texture_height": 64,
          "uv": [
            8,
            0
          ],
          "uv_size": [
            8,
            8
          ]
        }
      },
      "minecraft:emitter_shape_sphere": {
        "radius": 0.15,
        "surface_only": false,
        "direction": "outwards"
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "v.particle_age / v.particle_lifetime",
          "gradient": {
            "0.0": [
              1,
              0.95,
              0.6,
              1
            ],
            "1.0": [
              1,
              0.45,
              0.1,
              1
            ]
          }
        }
      },
      "minecraft:particle_motion_collision": {
        "coefficient_of_restitution": 0.3,
        "collision_radius": 0.05,
        "collision_drag": 4
      }
    }
  }
}
