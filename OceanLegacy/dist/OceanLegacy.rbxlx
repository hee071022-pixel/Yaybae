<Item class="ServerScriptService" referent="RBX0000000F"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Script" referent="RBX00000006"><Properties><string name="Name">Main</string><ProtectedString name="Source"><![CDATA[-- 오션 레거시 서버 진입점

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

Players.CharacterAutoLoads = false

-- 원격 이벤트 생성 (모듈보다 먼저)
local remotes = Instance.new("Folder")
remotes.Name = "Remotes"
for _, name in
	{
		"Attack",
		"Skill",
		"AddStat",
		"BuyFruit",
		"BuySword",
		"Travel",
		"RequestData",
		"Data",
		"Notify",
		"OpenShop",
	}
do
	local r = Instance.new("RemoteEvent")
	r.Name = name
	r.Parent = remotes
end
remotes.Parent = ReplicatedStorage

local Server = script.Parent:WaitForChild("Server")
local MapBuilder = require(Server.MapBuilder)
local EnemyService = require(Server.EnemyService)
local PlayerService = require(Server.PlayerService)
local CombatService = require(Server.CombatService)
local QuestShopService = require(Server.QuestShopService)

local world = MapBuilder.Build()

EnemyService.OnKilled = QuestShopService.OnKill
EnemyService.Init(world.EnemySpawns)
CombatService.Init()
QuestShopService.Init(world)
PlayerService.Init(world)

print(string.format("[OceanLegacy] 서버 준비 완료: 적 %d마리, NPC %d명", #world.EnemySpawns, #world.NPCs))
]]></ProtectedString></Properties></Item>
<Item class="Folder" referent="RBX0000000E"><Properties><string name="Name">Server</string></Properties><Item class="ModuleScript" referent="RBX00000007"><Properties><string name="Name">CombatService</string><ProtectedString name="Source"><![CDATA[-- 기본 공격(M1)과 스킬(Z/X/C/V) 처리 (서버 권한)

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.Shared.Config)
local Effects = require(script.Parent.Effects)
local EnemyService = require(script.Parent.EnemyService)
local PlayerService = require(script.Parent.PlayerService)

local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local CombatService = {}

local cooldowns = {} -- [player] = {[key] = readyTime}
local combo = {} -- [player] = {Count, Last}

---------------------------------------------------------------------------
-- 공통
---------------------------------------------------------------------------
local function equipped(player)
	local char = player.Character
	if not char then
		return nil
	end
	local hum = char:FindFirstChildOfClass("Humanoid")
	local root = char:FindFirstChild("HumanoidRootPart")
	local tool = char:FindFirstChildOfClass("Tool")
	if not hum or not root or hum.Health <= 0 or not tool then
		return nil
	end
	local kind, id = tool:GetAttribute("Kind"), tool:GetAttribute("ItemId")
	local set, color = Config.GetSkillSet(kind, id)
	if not set then
		return nil
	end
	return { Player = player, Char = char, Root = root, Kind = kind, Id = id, Set = set, Color = color }
end

local function multiplier(data, kind, id)
	local s = data.Stats
	if kind == "Combat" then
		return 1 + s.Melee * Config.StatScale
	elseif kind == "Sword" then
		return Config.Swords[id].Damage * (1 + s.Sword * Config.StatScale)
	end
	return 1 + s.Fruit * Config.StatScale
end

local function checkCooldown(player, key, duration)
	cooldowns[player] = cooldowns[player] or {}
	local now = os.clock()
	local ready = cooldowns[player][key]
	-- 네트워크 지연 감안해서 약간 여유
	if ready and now < ready - 0.15 then
		return false
	end
	cooldowns[player][key] = now + duration
	return true
end

local function aimDirection(root, target)
	if typeof(target) ~= "Vector3" then
		return root.CFrame.LookVector
	end
	local diff = target - root.Position
	if diff.Magnitude < 0.5 then
		return root.CFrame.LookVector
	end
	return diff.Unit
end

local function flat(v)
	local f = Vector3.new(v.X, 0, v.Z)
	return f.Magnitude > 0.01 and f.Unit or Vector3.new(0, 0, -1)
end

local function hitOpts(ctx, skill, from)
	return {
		From = from,
		Knockback = skill.Knockback,
		Pull = skill.Pull,
		Stun = skill.Stun,
		Burn = skill.Burn,
		BurnScale = ctx.Mult,
		Color = ctx.Kind == "Fruit" and ctx.Color or nil,
	}
end

local function hitArea(ctx, skill, center, radius, damage, already)
	local count = 0
	for _, enemy in EnemyService.FindInRadius(center, radius) do
		if not already or not already[enemy] then
			if already then
				already[enemy] = true
			end
			EnemyService.Damage(enemy, damage, ctx.Player, hitOpts(ctx, skill, center))
			count += 1
		end
	end
	return count
end

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
rayParams.IgnoreWater = true

local function castWorld(from, dir)
	local exclude = { Effects.Folder, EnemyService.Folder }
	for _, p in Players:GetPlayers() do
		if p.Character then
			table.insert(exclude, p.Character)
		end
	end
	rayParams.FilterDescendantsInstances = exclude
	return workspace:Raycast(from, dir, rayParams)
end

local function clampTarget(root, target, range)
	if typeof(target) ~= "Vector3" then
		return root.Position + root.CFrame.LookVector * math.min(range, 20)
	end
	local diff = target - root.Position
	if diff.Magnitude > range then
		return root.Position + diff.Unit * range
	end
	return target
end

---------------------------------------------------------------------------
-- 스킬 타입별 처리
---------------------------------------------------------------------------
local Handlers = {}

function Handlers.Melee(ctx, skill, dmg)
	local dir = flat(ctx.Aim)
	local center = ctx.Root.Position + dir * (skill.Range / 2)
	Effects.Slash(CFrame.lookAt(center, center + dir), skill.Radius * 1.6, ctx.Color)
	if skill.Knockback and skill.Knockback >= 100 then
		Effects.Sphere(center, skill.Radius, ctx.Color, 0.35)
	end
	hitArea(ctx, skill, center, skill.Radius, dmg)
end

function Handlers.Barrage(ctx, skill, dmg)
	task.spawn(function()
		for _ = 1, skill.Hits do
			if not ctx.Root.Parent then
				return
			end
			local dir = flat(ctx.Root.CFrame.LookVector)
			local center = ctx.Root.Position + dir * (skill.Range / 2)
			if skill.Range > 0 then
				Effects.Slash(CFrame.lookAt(center, center + dir) * CFrame.new(math.random(-2, 2), math.random(-1, 2), 0), skill.Radius, ctx.Color, 0.15)
			else
				Effects.Ring(ctx.Root.Position - Vector3.new(0, 2, 0), skill.Radius, ctx.Color, 0.2)
			end
			hitArea(ctx, skill, center, skill.Radius, dmg)
			task.wait(skill.Interval)
		end
	end)
end

function Handlers.AOE(ctx, skill, dmg)
	local center = ctx.Root.Position
	if skill.AtMouse then
		center = clampTarget(ctx.Root, ctx.Target, skill.Range or 50)
	end
	Effects.Sphere(center, skill.Radius, ctx.Color, 0.5)
	Effects.Ring(center - Vector3.new(0, 2, 0), skill.Radius * 1.2, ctx.Color, 0.6)
	if skill.Pull then
		Effects.Sphere(center, skill.Radius * 0.4, Color3.new(0, 0, 0), 1)
	end
	hitArea(ctx, skill, center, skill.Radius, dmg)
end

function Handlers.Projectile(ctx, skill, dmg)
	local dir = ctx.Aim
	local pos = ctx.Root.Position + dir * 3
	local ball = Effects.Projectile(pos, skill.Size, ctx.Color)
	task.spawn(function()
		local traveled = 0
		local hit = {}
		while traveled < skill.Range do
			local dt = RunService.Heartbeat:Wait()
			local step = skill.Speed * dt
			local wall = castWorld(pos, dir * step)
			pos += dir * step
			traveled += step
			ball.CFrame = CFrame.new(pos)
			if skill.Pierce then
				if hitArea(ctx, skill, pos, skill.Radius, dmg, hit) > 0 then
					Effects.Sphere(pos, skill.Radius, ctx.Color, 0.25)
				end
				if wall then
					break
				end
			else
				local touching = #EnemyService.FindInRadius(pos, skill.Size)
				if wall or touching > 0 then
					if wall then
						pos = wall.Position
					end
					Effects.Sphere(pos, skill.Radius, ctx.Color, 0.45)
					hitArea(ctx, skill, pos, skill.Radius, dmg)
					break
				end
			end
		end
		Effects.Fade(ball, 0.2)
	end)
end

local function hitAlongLine(ctx, skill, from, to, radius, dmg)
	local hit = {}
	local len = (to - from).Magnitude
	local steps = math.max(1, math.ceil(len / (radius * 0.8)))
	for i = 0, steps do
		hitArea(ctx, skill, from:Lerp(to, i / steps), radius, dmg, hit)
	end
end

function Handlers.Dash(ctx, skill, dmg)
	local root = ctx.Root
	local dir = flat(ctx.Aim)
	local from = root.Position
	local wall = castWorld(from, dir * skill.Range)
	local dist = wall and math.max(0, (wall.Position - from).Magnitude - 3) or skill.Range
	local to = from + dir * dist
	hitAlongLine(ctx, skill, from, to, skill.Radius, dmg)
	Effects.Beam(from, to, 2, ctx.Color, 0.4)
	root.CFrame = CFrame.lookAt(to, to + dir)
end

function Handlers.Beam(ctx, skill, dmg)
	local dir = ctx.Aim
	local from = ctx.Root.Position + dir * 2
	local wall = castWorld(from, dir * skill.Range)
	local to = wall and wall.Position or from + dir * skill.Range
	Effects.Beam(from, to, skill.Width, ctx.Color, 0.4)
	Effects.Sphere(to, skill.Width * 2, ctx.Color, 0.3)
	hitAlongLine(ctx, skill, from, to, skill.Width + 1.5, dmg)
end

function Handlers.Rain(ctx, skill, dmg)
	local center = clampTarget(ctx.Root, ctx.Target, skill.Range)
	Effects.Ring(center, skill.Radius, ctx.Color, skill.Duration)
	task.spawn(function()
		local interval = skill.Duration / skill.Count
		for _ = 1, skill.Count do
			local a = math.random() * math.pi * 2
			local d = math.sqrt(math.random()) * skill.Radius
			local p = center + Vector3.new(math.cos(a) * d, 0, math.sin(a) * d)
			local ground = castWorld(p + Vector3.new(0, 40, 0), Vector3.new(0, -80, 0))
			local impact = ground and ground.Position or p
			Effects.Beam(impact + Vector3.new(0, 60, 0), impact, 1.5, ctx.Color, 0.25)
			Effects.Sphere(impact, skill.ImpactRadius, ctx.Color, 0.35)
			hitArea(ctx, skill, impact, skill.ImpactRadius, dmg)
			task.wait(interval)
		end
	end)
end

---------------------------------------------------------------------------
-- 원격 처리
---------------------------------------------------------------------------
local function onAttack(player, target)
	local ctx = equipped(player)
	local data = PlayerService.Get(player)
	if not ctx or not data then
		return
	end
	local c = combo[player] or { Count = 0, Last = 0 }
	combo[player] = c
	local now = os.clock()
	if now - c.Last > 1 then
		c.Count = 0
	end
	local finisher = c.Count == 3
	if not checkCooldown(player, "M1", finisher and 0.6 or Config.M1Cooldown) then
		return
	end
	c.Count = (c.Count + 1) % 4
	c.Last = now

	local skill = ctx.Set.M1
	ctx.Aim = aimDirection(ctx.Root, target)
	ctx.Mult = multiplier(data, ctx.Kind, ctx.Id)
	local m1 = table.clone(skill)
	m1.Knockback = finisher and 45 or skill.Knockback
	local dmg = skill.Damage * ctx.Mult * (finisher and 1.5 or 1)
	Handlers.Melee(ctx, m1, dmg)
end

local function onSkill(player, key, target)
	if type(key) ~= "string" then
		return
	end
	local ctx = equipped(player)
	local data = PlayerService.Get(player)
	if not ctx or not data then
		return
	end
	local skill = ctx.Set[key]
	if type(skill) ~= "table" or not skill.Type then
		return
	end
	if data.Level < (skill.Level or 1) then
		PlayerService.Notify(
			player,
			string.format("%s 스킬은 Lv.%d부터 사용할 수 있습니다.", skill.Name, skill.Level),
			Color3.fromRGB(255, 120, 120)
		)
		return
	end
	if not checkCooldown(player, ctx.Kind .. ":" .. tostring(ctx.Id) .. ":" .. key, skill.Cooldown) then
		return
	end
	ctx.Target = target
	ctx.Aim = aimDirection(ctx.Root, target)
	ctx.Mult = multiplier(data, ctx.Kind, ctx.Id)
	local handler = Handlers[skill.Type]
	if handler then
		handler(ctx, skill, skill.Damage * ctx.Mult)
	end
end

function CombatService.Init()
	Remotes.Attack.OnServerEvent:Connect(onAttack)
	Remotes.Skill.OnServerEvent:Connect(onSkill)
	Players.PlayerRemoving:Connect(function(player)
		cooldowns[player] = nil
		combo[player] = nil
	end)
end

return CombatService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000008"><Properties><string name="Name">Effects</string><ProtectedString name="Source"><![CDATA[-- 서버에서 생성하는 시각 효과 (자동으로 모든 클라이언트에 보임)

local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")

local Effects = {}

local folder = Instance.new("Folder")
folder.Name = "Effects"
folder.Parent = workspace
Effects.Folder = folder

local function part(props)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Material = Enum.Material.Neon
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for k, v in props do
		p[k] = v
	end
	p.Parent = folder
	return p
end
Effects.Part = part

local function tween(inst, duration, goal, style)
	local t = TweenService:Create(inst, TweenInfo.new(duration, style or Enum.EasingStyle.Quad, Enum.EasingDirection.Out), goal)
	t:Play()
	return t
end

-- 퍼지는 구
function Effects.Sphere(pos, radius, color, duration)
	duration = duration or 0.4
	local p = part({ Shape = Enum.PartType.Ball, Size = Vector3.one, Color = color, Transparency = 0.15, CFrame = CFrame.new(pos) })
	tween(p, duration, { Size = Vector3.one * radius * 2, Transparency = 1 })
	Debris:AddItem(p, duration + 0.1)
end

-- 바닥에 퍼지는 고리
function Effects.Ring(pos, radius, color, duration)
	duration = duration or 0.5
	local cf = CFrame.new(pos) * CFrame.Angles(0, 0, math.rad(90))
	local p = part({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.4, 2, 2), Color = color, Transparency = 0.2, CFrame = cf })
	tween(p, duration, { Size = Vector3.new(0.4, radius * 2, radius * 2), Transparency = 1 })
	Debris:AddItem(p, duration + 0.1)
end

-- 직선 광선
function Effects.Beam(from, to, width, color, duration)
	duration = duration or 0.35
	local dist = (to - from).Magnitude
	if dist < 0.1 then
		return
	end
	local p = part({ Size = Vector3.new(width, width, dist), CFrame = CFrame.lookAt((from + to) / 2, to), Color = color, Transparency = 0.05 })
	tween(p, duration, { Size = Vector3.new(0, 0, dist), Transparency = 1 })
	Debris:AddItem(p, duration + 0.1)
end

-- 베기 궤적 (얇고 넓은 판)
function Effects.Slash(cf, width, color, duration)
	duration = duration or 0.25
	local tilt = math.rad(math.random(-40, 40))
	local p = part({ Size = Vector3.new(width, 0.2, width * 0.35), CFrame = cf * CFrame.Angles(0, 0, tilt), Color = color, Transparency = 0.1 })
	tween(p, duration, { Size = Vector3.new(width * 1.3, 0.05, width * 0.1), Transparency = 1 })
	Debris:AddItem(p, duration + 0.1)
end

-- 이동형 투사체 파트 (호출자가 CFrame을 갱신하고 제거)
function Effects.Projectile(pos, size, color)
	local p = part({ Shape = Enum.PartType.Ball, Size = Vector3.one * size, Color = color, CFrame = CFrame.new(pos) })
	local light = Instance.new("PointLight")
	light.Color = color
	light.Range = size * 4
	light.Brightness = 2
	light.Parent = p
	return p
end

function Effects.Fade(p, duration)
	tween(p, duration, { Transparency = 1, Size = p.Size * 1.5 })
	Debris:AddItem(p, duration + 0.1)
end

-- 떠오르는 데미지 숫자
function Effects.DamageNumber(adornee, amount, color)
	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.fromOffset(120, 40)
	bb.StudsOffset = Vector3.new((math.random() - 0.5) * 3, 2.5, 0)
	bb.AlwaysOnTop = true
	bb.MaxDistance = 150
	bb.Adornee = adornee
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.GothamBlack
	label.TextScaled = true
	label.Text = tostring(amount)
	label.TextColor3 = color or Color3.fromRGB(255, 230, 80)
	label.TextStrokeTransparency = 0.2
	label.Parent = bb
	bb.Parent = adornee
	tween(bb, 0.8, { StudsOffset = bb.StudsOffset + Vector3.new(0, 3, 0) })
	tween(label, 0.8, { TextTransparency = 1, TextStrokeTransparency = 1 }, Enum.EasingStyle.Quint)
	Debris:AddItem(bb, 0.85)
end

-- 레벨업 효과
function Effects.LevelUp(root)
	local pos = root.Position - Vector3.new(0, 2.5, 0)
	Effects.Ring(pos, 12, Color3.fromRGB(255, 220, 60), 0.8)
	Effects.Beam(pos, pos + Vector3.new(0, 30, 0), 4, Color3.fromRGB(255, 240, 120), 0.8)
end

return Effects
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000009"><Properties><string name="Name">EnemyService</string><ProtectedString name="Source"><![CDATA[-- 적 생성, AI, 피격, 처치 보상

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Rig = require(script.Parent.Rig)
local Effects = require(script.Parent.Effects)

local EnemyService = {}

-- 처치 시 호출: function(player, enemyDef)
EnemyService.OnKilled = nil

local folder = Instance.new("Folder")
folder.Name = "Enemies"
folder.Parent = workspace
EnemyService.Folder = folder

local records = {} -- [model] = record

local WALK_ANIM = "rbxassetid://507777826"
local IDLE_ANIM = "rbxassetid://507766388"

local overlap = OverlapParams.new()
overlap.FilterType = Enum.RaycastFilterType.Include
overlap.FilterDescendantsInstances = { folder }

---------------------------------------------------------------------------
-- 검색
---------------------------------------------------------------------------
function EnemyService.FindInRadius(pos, radius)
	local list, seen = {}, {}
	for _, p in workspace:GetPartBoundsInRadius(pos, radius, overlap) do
		local model = p:FindFirstAncestorOfClass("Model")
		while model and model.Parent ~= folder do
			model = model:FindFirstAncestorOfClass("Model")
		end
		if model and not seen[model] then
			seen[model] = true
			local rec = records[model]
			if rec and not rec.Dead then
				table.insert(list, model)
			end
		end
	end
	return list
end

function EnemyService.GetRecord(model)
	return records[model]
end

---------------------------------------------------------------------------
-- 피격
---------------------------------------------------------------------------
-- opts: {From=Vector3, Knockback, Stun, Burn={Damage,Ticks}, Pull, Color}
function EnemyService.Damage(model, amount, player, opts)
	local rec = records[model]
	if not rec or rec.Dead then
		return
	end
	opts = opts or {}
	amount = math.max(1, math.floor(amount * (0.9 + math.random() * 0.2)))
	rec.LastHitBy = player
	if player then
		rec.Target = player
	end
	rec.Humanoid.Health = math.max(0, rec.Humanoid.Health - amount)
	Effects.DamageNumber(rec.Root, amount, opts.Color)

	if rec.Humanoid.Health <= 0 then
		return
	end

	local from = opts.From
	if from and (opts.Knockback or opts.Pull) then
		local diff = rec.Root.Position - from
		local flat = Vector3.new(diff.X, 0, diff.Z)
		local dir = flat.Magnitude > 0.1 and flat.Unit or rec.Root.CFrame.LookVector * -1
		local scale = rec.Def.Boss and 0.25 or 1
		if opts.Knockback then
			rec.Root.AssemblyLinearVelocity = (dir * opts.Knockback + Vector3.new(0, opts.Knockback * 0.35, 0)) * scale
		elseif opts.Pull then
			rec.Root.AssemblyLinearVelocity = -dir * math.min(opts.Pull, flat.Magnitude * 4) * scale
		end
	end
	if opts.Stun then
		local dur = rec.Def.Boss and opts.Stun * 0.4 or opts.Stun
		rec.StunUntil = math.max(rec.StunUntil, os.clock() + dur)
	end
	if opts.Burn then
		local burn = opts.Burn
		task.spawn(function()
			for _ = 1, burn.Ticks do
				task.wait(0.5)
				if rec.Dead or not model.Parent then
					return
				end
				EnemyService.Damage(model, burn.Damage * (opts.BurnScale or 1), player, { Color = Color3.fromRGB(255, 140, 40) })
			end
		end)
	end
end

---------------------------------------------------------------------------
-- 생성 / 사망
---------------------------------------------------------------------------
local spawnEnemy

local function onDied(rec)
	if rec.Dead then
		return
	end
	rec.Dead = true
	local model = rec.Model
	records[model] = nil
	if rec.WalkTrack then
		rec.WalkTrack:Stop()
	end

	local killer = rec.LastHitBy
	if killer and killer.Parent and EnemyService.OnKilled then
		task.spawn(EnemyService.OnKilled, killer, rec.Def)
	end

	Effects.Sphere(rec.Root.Position, 6, Color3.fromRGB(255, 255, 255), 0.5)
	task.delay(2, function()
		model:Destroy()
	end)
	task.delay(rec.Def.RespawnTime, function()
		spawnEnemy(rec.Def, rec.SpawnPos)
	end)
end

function spawnEnemy(def, spawnPos)
	local model = Rig.Create("Enemy_" .. def.Id, def)
	local hum = model:FindFirstChildOfClass("Humanoid")
	local root = model:FindFirstChild("HumanoidRootPart")
	hum.MaxHealth = def.Health
	hum.Health = def.Health
	hum.WalkSpeed = def.WalkSpeed
	model:PivotTo(CFrame.new(spawnPos + Vector3.new(0, Rig.RootHeight(model) + 1, 0)) * CFrame.Angles(0, math.random() * 6.28, 0))
	model:SetAttribute("EnemyId", def.Id)

	local plateColor = def.Boss and Color3.fromRGB(255, 80, 80) or Color3.fromRGB(255, 255, 255)
	local plate = Rig.Nameplate(model, string.format("[Lv.%d] %s", def.Level, def.Name), plateColor, true)
	local fill = plate.HealthBack.Fill

	local rec = {
		Model = model,
		Humanoid = hum,
		Root = root,
		Def = def,
		SpawnPos = spawnPos,
		StunUntil = 0,
		LastAttack = 0,
		Target = nil,
		LastHitBy = nil,
		Dead = false,
	}
	records[model] = rec

	hum.HealthChanged:Connect(function(hp)
		fill.Size = UDim2.fromScale(math.clamp(hp / hum.MaxHealth, 0, 1), 1)
	end)
	hum.Died:Connect(function()
		onDied(rec)
	end)

	model.Parent = folder
	pcall(function()
		root:SetNetworkOwner(nil)
	end)

	-- R15일 때만 기본 걷기/대기 애니메이션
	if hum.RigType == Enum.HumanoidRigType.R15 then
		pcall(function()
			local animator = hum:FindFirstChildOfClass("Animator") or Instance.new("Animator", hum)
			local walk = Instance.new("Animation")
			walk.AnimationId = WALK_ANIM
			local idle = Instance.new("Animation")
			idle.AnimationId = IDLE_ANIM
			rec.WalkTrack = animator:LoadAnimation(walk)
			rec.IdleTrack = animator:LoadAnimation(idle)
			rec.IdleTrack.Looped = true
			rec.WalkTrack.Looped = true
			rec.IdleTrack:Play()
		end)
	end
	return model
end

---------------------------------------------------------------------------
-- AI
---------------------------------------------------------------------------
local function aliveRoot(player)
	local char = player and player.Character
	if not char then
		return nil
	end
	local hum = char:FindFirstChildOfClass("Humanoid")
	local root = char:FindFirstChild("HumanoidRootPart")
	if hum and root and hum.Health > 0 then
		return root, hum
	end
	return nil
end

local function attack(rec, targetRoot, targetHum)
	rec.LastAttack = os.clock()
	local pos = rec.Root.Position
	rec.Root.CFrame = CFrame.lookAt(pos, Vector3.new(targetRoot.Position.X, pos.Y, targetRoot.Position.Z))
	local scale = rec.Def.Scale or 1
	Effects.Slash(rec.Root.CFrame * CFrame.new(0, 0, -2.5 * scale), 6 * scale, rec.Def.Boss and Color3.fromRGB(255, 80, 80) or Color3.fromRGB(255, 255, 255))
	targetHum:TakeDamage(rec.Def.Damage)
	if rec.Def.Boss then
		-- 보스는 주변 범위 공격도 함
		for _, player in Players:GetPlayers() do
			local r, h = aliveRoot(player)
			if r and h ~= targetHum and (r.Position - pos).Magnitude < 10 * scale then
				h:TakeDamage(rec.Def.Damage * 0.5)
			end
		end
	end
end

local function updateAnim(rec)
	if not rec.WalkTrack then
		return
	end
	local v = rec.Root.AssemblyLinearVelocity
	local moving = Vector3.new(v.X, 0, v.Z).Magnitude > 2
	if moving and not rec.WalkTrack.IsPlaying then
		rec.WalkTrack:Play()
	elseif not moving and rec.WalkTrack.IsPlaying then
		rec.WalkTrack:Stop()
	end
end

local function update(rec, now)
	local def = rec.Def
	local hum, root = rec.Humanoid, rec.Root
	updateAnim(rec)

	if now < rec.StunUntil then
		hum.WalkSpeed = 0
		return
	end
	hum.WalkSpeed = def.WalkSpeed

	local pos = root.Position
	local fromSpawn = (pos - rec.SpawnPos).Magnitude

	-- 타겟 유지/해제
	local tRoot, tHum = aliveRoot(rec.Target)
	if tRoot and ((tRoot.Position - rec.SpawnPos).Magnitude > def.LeashRange or fromSpawn > def.LeashRange * 1.3) then
		tRoot = nil
	end
	if not tRoot then
		rec.Target = nil
		local best, bestDist = nil, def.AggroRange
		for _, player in Players:GetPlayers() do
			local r = aliveRoot(player)
			if r then
				local d = (r.Position - pos).Magnitude
				if d < bestDist and (r.Position - rec.SpawnPos).Magnitude < def.LeashRange then
					best, bestDist = player, d
				end
			end
		end
		rec.Target = best
		tRoot, tHum = aliveRoot(best)
	end

	if tRoot then
		local dist = (tRoot.Position - pos).Magnitude
		if dist > def.AttackRange then
			hum:MoveTo(tRoot.Position)
		else
			hum:MoveTo(pos)
			if now - rec.LastAttack >= def.AttackCooldown then
				attack(rec, tRoot, tHum)
			end
		end
	else
		-- 체력 천천히 회복하며 귀환
		if hum.Health < hum.MaxHealth then
			hum.Health = math.min(hum.MaxHealth, hum.Health + hum.MaxHealth * 0.02)
		end
		if fromSpawn > 6 then
			hum:MoveTo(rec.SpawnPos)
		elseif math.random() < 0.02 then
			hum:MoveTo(rec.SpawnPos + Vector3.new(math.random(-10, 10), 0, math.random(-10, 10)))
		end
	end

	-- 바다에 빠지거나 맵 밖으로 나가면 복귀
	if pos.Y < -20 then
		root.CFrame = CFrame.new(rec.SpawnPos + Vector3.new(0, 5, 0))
	end
end

function EnemyService.Init(spawns)
	for _, s in spawns do
		local def = Config.Enemies[s.EnemyId]
		if def then
			spawnEnemy(def, s.Position)
		end
	end
	task.spawn(function()
		while true do
			task.wait(0.15)
			local now = os.clock()
			for _, rec in records do
				if not rec.Dead then
					local ok, err = pcall(update, rec, now)
					if not ok then
						warn("[EnemyService]", err)
					end
				end
			end
		end
	end)
end

return EnemyService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000000A"><Properties><string name="Name">MapBuilder</string><ProtectedString name="Source"><![CDATA[-- 바다와 섬을 Terrain + 파트로 생성

local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Rig = require(script.Parent.Rig)

local MapBuilder = {}

local C = Color3.fromRGB
local rng = Random.new(20261014)
local terrain = workspace.Terrain
local mapFolder

local Themes = {
	Starter = { Shore = Enum.Material.Sand, Ground = Enum.Material.Grass, Decor = { Palm = 16, House = 4, Rock = 6 } },
	Jungle = { Shore = Enum.Material.Sand, Ground = Enum.Material.LeafyGrass, Decor = { Tree = 40, Rock = 10 } },
	Desert = { Shore = Enum.Material.Sandstone, Ground = Enum.Material.Sand, Decor = { Cactus = 22, Rock = 8, Pyramid = 1 } },
	Snow = { Shore = Enum.Material.Rock, Ground = Enum.Material.Snow, Decor = { Pine = 30, Crystal = 10 } },
	Marine = { Shore = Enum.Material.Rock, Ground = Enum.Material.Pavement, Decor = { Tower = 6, Crate = 12 }, Walls = true },
}

-- 역할별 NPC 설정
local NpcInfo = {
	Quest = {
		Title = "퀘스트 안내원",
		Action = "퀘스트 받기",
		Skin = C(234, 184, 146),
		Shirt = C(60, 120, 220),
		Pants = C(40, 40, 60),
		Color = C(255, 220, 80),
	},
	Travel = {
		Title = "항해사",
		Action = "다른 섬으로 이동",
		Skin = C(204, 142, 105),
		Shirt = C(240, 240, 240),
		Pants = C(30, 50, 120),
		Color = C(120, 220, 255),
	},
	Fruit = {
		Title = "열매 상인",
		Action = "악마의 열매 뽑기",
		Skin = C(234, 184, 146),
		Shirt = C(150, 50, 200),
		Pants = C(60, 20, 80),
		Color = C(230, 120, 255),
	},
	Sword = { Title = "대장장이", Action = "검 상점", Skin = C(204, 142, 105), Shirt = C(90, 90, 90), Pants = C(50, 35, 25), Color = C(200, 200, 210) },
}

---------------------------------------------------------------------------
-- 유틸
---------------------------------------------------------------------------
local function part(parent, props)
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for k, v in props do
		p[k] = v
	end
	p.Parent = parent
	return p
end

local groundParams = RaycastParams.new()
groundParams.FilterType = Enum.RaycastFilterType.Include
groundParams.IgnoreWater = true

local function groundAt(x, z)
	groundParams.FilterDescendantsInstances = { terrain, mapFolder }
	local result = workspace:Raycast(Vector3.new(x, 300, z), Vector3.new(0, -400, 0), groundParams)
	if result then
		return result.Position
	end
	return Vector3.new(x, Config.GroundY, z)
end
MapBuilder.GroundAt = groundAt

local function randomPointOnIsland(island, minDist, maxFrac, avoid)
	local c = island.Center
	for _ = 1, 30 do
		local angle = rng:NextNumber(0, math.pi * 2)
		local dist = rng:NextNumber(minDist, island.Radius * maxFrac)
		local x, z = c.X + math.cos(angle) * dist, c.Z + math.sin(angle) * dist
		local ok = true
		for _, a in avoid do
			if (Vector2.new(x, z) - Vector2.new(a.Position.X, a.Position.Z)).Magnitude < a.Radius then
				ok = false
				break
			end
		end
		if ok then
			return x, z
		end
	end
	return nil
end

---------------------------------------------------------------------------
-- 장식물
---------------------------------------------------------------------------
local Decor = {}

function Decor.Palm(parent, pos)
	local h = rng:NextNumber(12, 18)
	local lean = CFrame.Angles(math.rad(rng:NextNumber(-10, 10)), rng:NextNumber(0, 6.28), math.rad(rng:NextNumber(-10, 10)))
	local base = CFrame.new(pos) * lean
	part(parent, { Size = Vector3.new(1.6, h, 1.6), CFrame = base * CFrame.new(0, h / 2, 0), Color = C(140, 100, 60), Material = Enum.Material.Wood })
	for i = 1, 5 do
		local a = CFrame.Angles(0, math.rad(i * 72), 0)
		part(parent, {
			Size = Vector3.new(2, 0.4, 9),
			CFrame = base * CFrame.new(0, h, 0) * a * CFrame.new(0, 0, -4) * CFrame.Angles(math.rad(-20), 0, 0),
			Color = C(60, 160, 60),
			Material = Enum.Material.Grass,
		})
	end
end

function Decor.Tree(parent, pos)
	local h = rng:NextNumber(14, 24)
	part(
		parent,
		{ Size = Vector3.new(2.5, h, 2.5), CFrame = CFrame.new(pos + Vector3.new(0, h / 2, 0)), Color = C(110, 75, 45), Material = Enum.Material.Wood }
	)
	local r = rng:NextNumber(9, 14)
	part(parent, {
		Shape = Enum.PartType.Ball,
		Size = Vector3.one * r,
		CFrame = CFrame.new(pos + Vector3.new(0, h, 0)),
		Color = C(40, rng:NextInteger(110, 150), 40),
		Material = Enum.Material.Grass,
	})
	part(parent, {
		Shape = Enum.PartType.Ball,
		Size = Vector3.one * r * 0.7,
		CFrame = CFrame.new(pos + Vector3.new(r * 0.35, h - 2, 0)),
		Color = C(50, 130, 45),
		Material = Enum.Material.Grass,
	})
end

function Decor.Pine(parent, pos)
	local h = rng:NextNumber(10, 16)
	part(parent, { Size = Vector3.new(1.6, h, 1.6), CFrame = CFrame.new(pos + Vector3.new(0, h / 2, 0)), Color = C(90, 60, 40), Material = Enum.Material.Wood })
	for i = 0, 2 do
		local s = 10 - i * 3
		part(parent, {
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(s, s * 0.6, s),
			CFrame = CFrame.new(pos + Vector3.new(0, h * 0.45 + i * 3.5, 0)),
			Color = C(235, 245, 255),
			Material = Enum.Material.Snow,
		})
	end
end

function Decor.Cactus(parent, pos)
	local h = rng:NextNumber(6, 11)
	local color = C(70, 140, 60)
	part(parent, {
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(h, 2, 2),
		CFrame = CFrame.new(pos + Vector3.new(0, h / 2, 0)) * CFrame.Angles(0, 0, math.rad(90)),
		Color = color,
		Material = Enum.Material.Grass,
	})
	local side = rng:NextInteger(0, 1) == 0 and -1 or 1
	part(parent, {
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(3, 1.4, 1.4),
		CFrame = CFrame.new(pos + Vector3.new(side * 1.6, h * 0.55, 0)),
		Color = color,
		Material = Enum.Material.Grass,
	})
	part(parent, {
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(3, 1.4, 1.4),
		CFrame = CFrame.new(pos + Vector3.new(side * 3, h * 0.55 + 1.5, 0)) * CFrame.Angles(0, 0, math.rad(90)),
		Color = color,
		Material = Enum.Material.Grass,
	})
end

function Decor.Rock(parent, pos)
	local s = rng:NextNumber(4, 9)
	part(parent, {
		Size = Vector3.new(s, s * 0.7, s * 0.9),
		CFrame = CFrame.new(pos + Vector3.new(0, s * 0.25, 0)) * CFrame.Angles(rng:NextNumber(-0.3, 0.3), rng:NextNumber(0, 6.28), rng:NextNumber(-0.3, 0.3)),
		Color = C(110, 110, 115),
		Material = Enum.Material.Slate,
	})
end

function Decor.Crystal(parent, pos)
	local h = rng:NextNumber(6, 12)
	part(parent, {
		Size = Vector3.new(2.5, h, 2.5),
		CFrame = CFrame.new(pos + Vector3.new(0, h / 2 - 1, 0)) * CFrame.Angles(rng:NextNumber(-0.3, 0.3), rng:NextNumber(0, 6.28), rng:NextNumber(-0.3, 0.3)),
		Color = C(150, 220, 255),
		Material = Enum.Material.Ice,
		Transparency = 0.2,
	})
end

function Decor.Crate(parent, pos)
	local s = rng:NextNumber(3, 5)
	part(parent, {
		Size = Vector3.one * s,
		CFrame = CFrame.new(pos + Vector3.new(0, s / 2, 0)) * CFrame.Angles(0, rng:NextNumber(0, 6.28), 0),
		Color = C(150, 110, 60),
		Material = Enum.Material.WoodPlanks,
	})
end

function Decor.House(parent, pos)
	local yaw = CFrame.Angles(0, rng:NextNumber(0, 6.28), 0)
	local base = CFrame.new(pos) * yaw
	part(parent, { Size = Vector3.new(16, 10, 14), CFrame = base * CFrame.new(0, 5, 0), Color = C(220, 200, 160), Material = Enum.Material.WoodPlanks })
	local roofColor = C(170, 60, 50)
	part(parent, {
		Size = Vector3.new(18, 1, 10),
		CFrame = base * CFrame.new(0, 12.2, -3.6) * CFrame.Angles(math.rad(35), 0, 0),
		Color = roofColor,
		Material = Enum.Material.Slate,
	})
	part(parent, {
		Size = Vector3.new(18, 1, 10),
		CFrame = base * CFrame.new(0, 12.2, 3.6) * CFrame.Angles(math.rad(-35), 0, 0),
		Color = roofColor,
		Material = Enum.Material.Slate,
	})
	part(parent, { Size = Vector3.new(4, 7, 0.4), CFrame = base * CFrame.new(0, 3.5, -7.1), Color = C(100, 70, 40), Material = Enum.Material.Wood })
end

function Decor.Tower(parent, pos)
	local h = rng:NextNumber(25, 35)
	part(parent, {
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(h, 12, 12),
		CFrame = CFrame.new(pos + Vector3.new(0, h / 2, 0)) * CFrame.Angles(0, 0, math.rad(90)),
		Color = C(200, 200, 205),
		Material = Enum.Material.Concrete,
	})
	part(parent, {
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(2, 14, 14),
		CFrame = CFrame.new(pos + Vector3.new(0, h + 1, 0)) * CFrame.Angles(0, 0, math.rad(90)),
		Color = C(40, 70, 150),
		Material = Enum.Material.Concrete,
	})
	part(
		parent,
		{ Size = Vector3.new(0.5, 10, 0.5), CFrame = CFrame.new(pos + Vector3.new(0, h + 7, 0)), Color = C(80, 80, 80), Material = Enum.Material.Metal }
	)
	part(
		parent,
		{ Size = Vector3.new(0.2, 3, 5), CFrame = CFrame.new(pos + Vector3.new(0, h + 10, 2.6)), Color = C(30, 80, 200), Material = Enum.Material.Fabric }
	)
end

function Decor.Pyramid(parent, pos)
	for i = 0, 7 do
		local s = 50 - i * 6
		part(parent, {
			Size = Vector3.new(s, 4, s),
			CFrame = CFrame.new(pos + Vector3.new(0, i * 4 + 2, 0)),
			Color = C(220, 190, 120),
			Material = Enum.Material.Sandstone,
		})
	end
end

local function marineWalls(parent, island)
	local c = island.Center
	local r = island.Radius * 0.88
	local segments = 28
	for i = 0, segments - 1 do
		-- 출입구용 틈
		if i % 7 ~= 0 then
			local a = (i + 0.5) / segments * math.pi * 2
			local x, z = c.X + math.cos(a) * r, c.Z + math.sin(a) * r
			local g = groundAt(x, z)
			local len = 2 * math.pi * r / segments + 1
			part(parent, {
				Size = Vector3.new(len, 14, 4),
				CFrame = CFrame.new(g + Vector3.new(0, 6, 0)) * CFrame.Angles(0, -a + math.pi / 2, 0),
				Color = C(215, 215, 220),
				Material = Enum.Material.Concrete,
			})
		end
	end
end

---------------------------------------------------------------------------
-- NPC
---------------------------------------------------------------------------
local function createNpc(role, island, position, faceTo)
	local info = NpcInfo[role]
	local model = Rig.Create("Npc_" .. role, info)
	model.Name = info.Title
	local root = model:FindFirstChild("HumanoidRootPart")
	root.Anchored = true
	local ground = groundAt(position.X, position.Z)
	local rootPos = ground + Vector3.new(0, Rig.RootHeight(model), 0)
	model:PivotTo(CFrame.lookAt(rootPos, Vector3.new(faceTo.X, rootPos.Y, faceTo.Z)))
	model:SetAttribute("Role", role)
	model:SetAttribute("Island", island.Id)
	Rig.Nameplate(model, info.Title, info.Color, false)

	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = info.Action
	prompt.ObjectText = info.Title
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 12
	prompt.RequiresLineOfSight = false
	prompt.Parent = root

	model.Parent = mapFolder.NPCs
	return { Role = role, Island = island.Id, Model = model, Prompt = prompt, Position = rootPos }
end

---------------------------------------------------------------------------
-- 빌드
---------------------------------------------------------------------------
local function setupLighting()
	Lighting.ClockTime = 14
	Lighting.Brightness = 2.5
	Lighting.OutdoorAmbient = C(150, 150, 160)
	Lighting.GlobalShadows = true
	if not Lighting:FindFirstChildOfClass("Atmosphere") then
		local atm = Instance.new("Atmosphere")
		atm.Density = 0.28
		atm.Haze = 1
		atm.Color = C(200, 225, 255)
		atm.Decay = C(110, 150, 200)
		atm.Parent = Lighting
	end
	terrain.WaterColor = C(20, 120, 190)
	terrain.WaterTransparency = 0.6
	terrain.WaterWaveSize = 0.3
	terrain.WaterWaveSpeed = 12
end

local function buildSea()
	-- 큰 영역은 나눠서 채움
	local minX, maxX = -560, 3280
	local chunk = 480
	for x = minX, maxX - 1, chunk do
		local cx = x + chunk / 2
		terrain:FillBlock(CFrame.new(cx, -36, 0), Vector3.new(chunk, 8, 1400), Enum.Material.Sand)
		terrain:FillBlock(CFrame.new(cx, -16, 0), Vector3.new(chunk, 32, 1400), Enum.Material.Water)
	end
end

local function buildIsland(island, world)
	local theme = Themes[island.Theme]
	local c = island.Center
	local R = island.Radius
	local folder = Instance.new("Folder")
	folder.Name = island.Id
	folder.Parent = mapFolder

	-- 지형
	terrain:FillCylinder(CFrame.new(c.X, -14, c.Z), 44, R, theme.Shore)
	terrain:FillCylinder(CFrame.new(c.X, 6, c.Z), 4, R - 18, theme.Ground)
	for i = 1, 5 do
		local a = rng:NextNumber(0, math.pi * 2)
		local d = rng:NextNumber(R * 0.7, R * 0.82)
		terrain:FillBall(Vector3.new(c.X + math.cos(a) * d, 2, c.Z + math.sin(a) * d), rng:NextNumber(12, 20), theme.Ground)
	end

	-- 광장 + 스폰 지점
	local plaza = part(folder, {
		Name = "Plaza",
		Size = Vector3.new(44, 1, 44),
		CFrame = CFrame.new(c.X, Config.GroundY + 0.4, c.Z),
		Color = island.Theme == "Marine" and C(60, 70, 110) or C(150, 110, 70),
		Material = island.Theme == "Marine" and Enum.Material.Slate or Enum.Material.WoodPlanks,
	})
	world.Spawns[island.Id] = CFrame.new(plaza.Position + Vector3.new(0, 4, 0))

	-- 섬 이름 간판
	local sign = part(
		folder,
		{ Name = "Sign", Size = Vector3.new(1, 1, 1), Transparency = 1, CanCollide = false, CFrame = CFrame.new(plaza.Position + Vector3.new(0, 22, 0)) }
	)
	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.fromOffset(360, 70)
	bb.MaxDistance = 400
	bb.Parent = sign
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.GothamBlack
	label.TextScaled = true
	label.TextColor3 = C(255, 255, 255)
	label.TextStrokeTransparency = 0
	label.Text = string.format("%s  (Lv.%d+)", island.Name, island.Level)
	label.Parent = bb

	-- 적 무리 배치: 일반 몹은 섬 둘레에, 보스는 마지막
	local enemies = {}
	for id, e in Config.Enemies do
		if e.Island == island.Id then
			table.insert(enemies, e)
		end
	end
	table.sort(enemies, function(a, b)
		return a.Level < b.Level
	end)

	local avoid = { { Position = c, Radius = 34 } }
	local startAngle = rng:NextNumber(0, math.pi * 2)
	for i, e in enemies do
		local a = startAngle + (i - 1) / #enemies * math.pi * 2
		local dist = R * (e.Boss and 0.6 or 0.5)
		local gc = Vector3.new(c.X + math.cos(a) * dist, 0, c.Z + math.sin(a) * dist)
		table.insert(avoid, { Position = gc, Radius = 22 })
		for _ = 1, e.Count do
			local spread = e.Boss and 0 or 16
			local x = gc.X + rng:NextNumber(-spread, spread)
			local z = gc.Z + rng:NextNumber(-spread, spread)
			table.insert(world.EnemySpawns, { EnemyId = e.Id, Position = groundAt(x, z) })
		end
		if e.Boss then
			-- 보스 구역 표시 고리
			local g = groundAt(gc.X, gc.Z)
			part(folder, {
				Name = "BossArena",
				Shape = Enum.PartType.Cylinder,
				Size = Vector3.new(0.6, 36, 36),
				CFrame = CFrame.new(g + Vector3.new(0, 0.1, 0)) * CFrame.Angles(0, 0, math.rad(90)),
				Color = C(150, 30, 30),
				Material = Enum.Material.Slate,
				CanCollide = false,
			})
		end
	end

	-- 장식
	if theme.Walls then
		marineWalls(folder, island)
	end
	for kind, count in theme.Decor do
		for _ = 1, count do
			local minDist = kind == "Pyramid" and R * 0.3 or 30
			local x, z = randomPointOnIsland(island, minDist, kind == "Pyramid" and 0.4 or 0.8, avoid)
			if x then
				local g = groundAt(x, z)
				Decor[kind](folder, g)
				table.insert(avoid, { Position = g, Radius = kind == "Pyramid" and 34 or (kind == "House" or kind == "Tower") and 14 or 5 })
			end
		end
	end

	-- NPC
	local roles = { "Quest", "Travel" }
	if island.Id == "Starter" then
		table.insert(roles, "Fruit")
		table.insert(roles, "Sword")
	elseif island.Id == "Marine" or island.Id == "Desert" then
		table.insert(roles, "Sword")
	end
	local corners = { Vector3.new(-14, 0, -14), Vector3.new(14, 0, -14), Vector3.new(-14, 0, 14), Vector3.new(14, 0, 14) }
	for i, role in roles do
		local pos = plaza.Position + corners[i]
		table.insert(world.NPCs, createNpc(role, island, pos, plaza.Position))
	end
end

function MapBuilder.Build()
	mapFolder = Instance.new("Folder")
	mapFolder.Name = "Map"
	local npcs = Instance.new("Folder")
	npcs.Name = "NPCs"
	npcs.Parent = mapFolder
	mapFolder.Parent = workspace

	setupLighting()
	buildSea()

	local world = { Spawns = {}, EnemySpawns = {}, NPCs = {} }
	for _, island in Config.Islands do
		buildIsland(island, world)
	end
	return world
end

return MapBuilder
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000000B"><Properties><string name="Name">PlayerService</string><ProtectedString name="Source"><![CDATA[-- 플레이어 데이터(저장/불러오기), 레벨업, 스탯, 도구 지급, 캐릭터 스폰

local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Effects = require(script.Parent.Effects)

local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local PlayerService = {}

local profiles = {} -- [player] = data
local world

local store
do
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore("OceanLegacy_v1")
	end)
	if ok then
		store = result
	else
		warn("[PlayerService] DataStore 사용 불가 (Studio에서는 게임 설정 > 보안 > API 서비스 허용 필요):", result)
	end
end

local function defaultData()
	return {
		Level = 1,
		XP = 0,
		Beli = Config.StartBeli,
		Points = 0,
		Stats = { Melee = 0, Defense = 0, Sword = 0, Fruit = 0 },
		Swords = {},
		Fruit = nil,
		Quest = nil,
		SpawnIsland = "Starter",
	}
end

local function reconcile(data, template)
	for k, v in template do
		if data[k] == nil then
			data[k] = v
		elseif type(v) == "table" and type(data[k]) == "table" then
			reconcile(data[k], v)
		end
	end
	return data
end

---------------------------------------------------------------------------
-- 공용 API
---------------------------------------------------------------------------
function PlayerService.Get(player)
	return profiles[player]
end

function PlayerService.Notify(player, text, color)
	Remotes.Notify:FireClient(player, text, color)
end

function PlayerService.Sync(player)
	local data = profiles[player]
	if not data then
		return
	end
	Remotes.Data:FireClient(player, data)
	local ls = player:FindFirstChild("leaderstats")
	if ls then
		ls.Level.Value = data.Level
		ls.Beli.Value = data.Beli
	end
end

function PlayerService.ApplyStats(player, heal)
	local data = profiles[player]
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not data or not hum or hum.Health <= 0 then
		return
	end
	local ratio = hum.Health / math.max(1, hum.MaxHealth)
	hum.MaxHealth = Config.MaxHealth(data.Level, data.Stats.Defense)
	hum.Health = heal and hum.MaxHealth or hum.MaxHealth * ratio
end

function PlayerService.AddBeli(player, amount)
	local data = profiles[player]
	if not data then
		return
	end
	data.Beli += amount
	PlayerService.Sync(player)
end

function PlayerService.AddXP(player, amount)
	local data = profiles[player]
	if not data then
		return
	end
	if data.Level >= Config.MaxLevel then
		return
	end
	data.XP += amount
	local leveled = false
	while data.Level < Config.MaxLevel and data.XP >= Config.XPForLevel(data.Level) do
		data.XP -= Config.XPForLevel(data.Level)
		data.Level += 1
		data.Points += Config.StatPointsPerLevel
		leveled = true
	end
	if data.Level >= Config.MaxLevel then
		data.XP = 0
	end
	if leveled then
		PlayerService.ApplyStats(player, true)
		PlayerService.Notify(
			player,
			string.format("레벨 업! Lv.%d (스탯 포인트 +%d)", data.Level, Config.StatPointsPerLevel),
			Color3.fromRGB(255, 220, 60)
		)
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		if root then
			Effects.LevelUp(root)
		end
	end
	PlayerService.Sync(player)
end

function PlayerService.AddStat(player, stat, amount)
	local data = profiles[player]
	if not data or type(stat) ~= "string" or data.Stats[stat] == nil then
		return
	end
	amount = math.floor(tonumber(amount) or 0)
	amount = math.clamp(amount, 0, data.Points)
	if amount <= 0 then
		return
	end
	data.Points -= amount
	data.Stats[stat] += amount
	PlayerService.ApplyStats(player, false)
	PlayerService.Sync(player)
end

---------------------------------------------------------------------------
-- 도구
---------------------------------------------------------------------------
local function makeTool(name, kind, id, tip)
	local tool = Instance.new("Tool")
	tool.Name = name
	tool.CanBeDropped = false
	tool.ToolTip = tip or ""
	tool:SetAttribute("Kind", kind)
	tool:SetAttribute("ItemId", id)
	tool.RequiresHandle = false
	return tool
end

local function makeSword(id)
	local def = Config.Swords[id]
	local tool = makeTool(def.Name, "Sword", id, "검 스킬: Z / X / C")
	tool.RequiresHandle = true
	tool.Grip = CFrame.new(0, 0, -def.Length / 2 + 0.6, 0, 0, 1, 1, 0, 0, 0, 1, 0)

	local blade = Instance.new("Part")
	blade.Name = "Handle"
	blade.Size = Vector3.new(0.25, 0.6, def.Length)
	blade.Color = def.Color
	blade.Material = def.Neon and Enum.Material.Neon or Enum.Material.Metal
	blade.CanCollide = false
	blade.Massless = true
	blade.Parent = tool

	local function attach(name, size, offset, color, material)
		local p = Instance.new("Part")
		p.Name = name
		p.Size = size
		p.Color = color
		p.Material = material
		p.CanCollide = false
		p.Massless = true
		p.CFrame = blade.CFrame * offset
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = blade
		weld.Part1 = p
		weld.Parent = p
		p.Parent = tool
	end
	local hiltZ = -def.Length / 2
	attach("Guard", Vector3.new(0.4, 1.6, 0.3), CFrame.new(0, 0, hiltZ + 1), Color3.fromRGB(200, 170, 60), Enum.Material.Metal)
	attach("Hilt", Vector3.new(0.35, 0.35, 1.2), CFrame.new(0, 0, hiltZ + 0.3), Color3.fromRGB(50, 30, 20), Enum.Material.Fabric)
	return tool
end

function PlayerService.GiveTools(player)
	local data = profiles[player]
	local backpack = player:FindFirstChildOfClass("Backpack") or player:WaitForChild("Backpack", 5)
	if not data or not backpack then
		return
	end
	-- 기존 도구 정리 (캐릭터가 들고 있는 것 포함)
	for _, container in { backpack, player.Character } do
		if container then
			for _, t in container:GetChildren() do
				if t:IsA("Tool") and t:GetAttribute("Kind") then
					t:Destroy()
				end
			end
		end
	end

	makeTool("주먹", "Combat", "Combat", "격투 스킬: Z / X / C").Parent = backpack
	table.sort(data.Swords, function(a, b)
		local sa, sb = Config.Swords[a], Config.Swords[b]
		return (sa and sa.Order or 0) < (sb and sb.Order or 0)
	end)
	for _, id in data.Swords do
		if Config.Swords[id] then
			makeSword(id).Parent = backpack
		end
	end
	if data.Fruit and Config.Fruits[data.Fruit] then
		makeTool(Config.Fruits[data.Fruit].Name, "Fruit", data.Fruit, "열매 스킬: Z / X / C / V").Parent = backpack
	end
end

---------------------------------------------------------------------------
-- 캐릭터 / 접속
---------------------------------------------------------------------------
function PlayerService.SpawnCFrame(player)
	local data = profiles[player]
	local id = data and data.SpawnIsland or "Starter"
	return world.Spawns[id] or world.Spawns.Starter
end

local function onCharacter(player, char)
	local hum = char:WaitForChild("Humanoid")
	local root = char:WaitForChild("HumanoidRootPart")
	hum.WalkSpeed = Config.WalkSpeed
	hum.UseJumpPower = true
	hum.JumpPower = Config.JumpPower

	task.defer(function()
		local cf = PlayerService.SpawnCFrame(player)
		char:PivotTo(cf * CFrame.new(math.random(-8, 8), 0, math.random(-8, 8)))
	end)

	PlayerService.ApplyStats(player, true)
	PlayerService.GiveTools(player)

	hum.Died:Connect(function()
		task.delay(Config.RespawnTime, function()
			if player.Parent then
				player:LoadCharacter()
			end
		end)
	end)

	-- 바다 깊이 빠졌을 때 구조
	task.spawn(function()
		while char.Parent and hum.Health > 0 do
			task.wait(1)
			if root.Position.Y < -45 then
				char:PivotTo(PlayerService.SpawnCFrame(player))
			end
		end
	end)
end

local function save(player)
	local data = profiles[player]
	if not data or not store or data._NoSave then
		return
	end
	local copy = table.clone(data)
	copy._NoSave = nil
	local ok, err = pcall(function()
		store:SetAsync("p_" .. player.UserId, copy)
	end)
	if not ok then
		warn("[PlayerService] 저장 실패:", player.Name, err)
	end
end
PlayerService.Save = save

local function onPlayerAdded(player)
	local data
	local loadFailed = false
	if store then
		local ok, result = pcall(function()
			return store:GetAsync("p_" .. player.UserId)
		end)
		if ok then
			if type(result) == "table" then
				data = result
			end
		else
			loadFailed = true
			warn("[PlayerService] 불러오기 실패:", result)
		end
	end
	data = reconcile(data or defaultData(), defaultData())
	if loadFailed then
		-- 불러오기에 실패하면 기존 저장을 덮어쓰지 않음
		data._NoSave = true
	end
	if not player.Parent then
		return
	end
	profiles[player] = data

	local ls = Instance.new("Folder")
	ls.Name = "leaderstats"
	local lv = Instance.new("IntValue")
	lv.Name = "Level"
	lv.Value = data.Level
	lv.Parent = ls
	local beli = Instance.new("IntValue")
	beli.Name = "Beli"
	beli.Value = data.Beli
	beli.Parent = ls
	ls.Parent = player

	player.CharacterAdded:Connect(function(char)
		onCharacter(player, char)
	end)
	player:LoadCharacter()
	PlayerService.Sync(player)
	if data.Level == 1 and data.XP == 0 then
		PlayerService.Notify(
			player,
			"오션 레거시에 오신 걸 환영합니다! 광장의 퀘스트 안내원(E)에게 말을 걸어보세요.",
			Color3.fromRGB(120, 220, 255)
		)
	end
end

function PlayerService.Init(builtWorld)
	world = builtWorld
	Players.PlayerAdded:Connect(onPlayerAdded)
	for _, p in Players:GetPlayers() do
		task.spawn(onPlayerAdded, p)
	end
	Players.PlayerRemoving:Connect(function(player)
		save(player)
		profiles[player] = nil
	end)
	game:BindToClose(function()
		for _, p in Players:GetPlayers() do
			save(p)
		end
	end)
	task.spawn(function()
		while true do
			task.wait(120)
			for _, p in Players:GetPlayers() do
				save(p)
			end
		end
	end)

	Remotes.RequestData.OnServerEvent:Connect(PlayerService.Sync)
	Remotes.AddStat.OnServerEvent:Connect(PlayerService.AddStat)
end

return PlayerService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000000C"><Properties><string name="Name">QuestShopService</string><ProtectedString name="Source"><![CDATA[-- 퀘스트, 열매 뽑기, 검 상점, 섬 이동 (NPC 상호작용)

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local PlayerService = require(script.Parent.PlayerService)

local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local Service = {}

local npcs = {}
local GOLD = Color3.fromRGB(255, 220, 80)
local RED = Color3.fromRGB(255, 110, 110)
local GREEN = Color3.fromRGB(120, 255, 140)

local function nearRole(player, role)
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not root then
		return false
	end
	for _, npc in npcs do
		if npc.Role == role and (npc.Position - root.Position).Magnitude < 25 then
			return true
		end
	end
	return false
end

---------------------------------------------------------------------------
-- 퀘스트
---------------------------------------------------------------------------
local function questText(q)
	local e = Config.Enemies[q.Target]
	return string.format("%s %d마리 처치", e.Name, q.Amount)
end

function Service.RequestQuest(player, islandId)
	local data = PlayerService.Get(player)
	if not data then
		return
	end
	data.SpawnIsland = islandId

	local best, lowest
	for _, q in Config.Quests do
		if q.Island == islandId then
			if q.Level <= data.Level and (not best or q.Level > best.Level) then
				best = q
			end
			if not lowest or q.Level < lowest.Level then
				lowest = q
			end
		end
	end
	if not best then
		PlayerService.Notify(player, string.format("이 섬의 퀘스트는 Lv.%d부터 받을 수 있어요.", lowest and lowest.Level or 0), RED)
		PlayerService.Sync(player)
		return
	end
	if data.Quest and data.Quest.Id == best.Id then
		PlayerService.Notify(player, string.format("진행 중: %s (%d/%d)", questText(best), data.Quest.Progress, best.Amount), GOLD)
		return
	end
	data.Quest = { Id = best.Id, Progress = 0 }
	PlayerService.Notify(player, "새 퀘스트: " .. questText(best) .. "  (이 섬이 부활 지점으로 설정됨)", GOLD)
	PlayerService.Sync(player)
end

function Service.OnKill(player, def)
	PlayerService.AddXP(player, def.XP)
	PlayerService.AddBeli(player, def.Beli)
	if def.Boss then
		for _, p in Players:GetPlayers() do
			PlayerService.Notify(
				p,
				string.format("%s님이 보스 [%s]을(를) 처치했습니다!", player.DisplayName, def.Name),
				Color3.fromRGB(255, 120, 60)
			)
		end
	end

	local data = PlayerService.Get(player)
	local active = data and data.Quest
	local q = active and Config.Quests[active.Id]
	if q and q.Target == def.Id then
		active.Progress += 1
		if active.Progress >= q.Amount then
			data.Quest = nil
			PlayerService.Notify(player, string.format("퀘스트 완료! +%d EXP, +%d 벨리", q.XP, q.Beli), GREEN)
			PlayerService.AddBeli(player, q.Beli)
			PlayerService.AddXP(player, q.XP)
		else
			PlayerService.Sync(player)
		end
	end
end

---------------------------------------------------------------------------
-- 열매 뽑기
---------------------------------------------------------------------------
local function rollFruit()
	local pool, total = {}, 0
	for id, fruit in Config.Fruits do
		local w = Config.RarityWeights[fruit.Rarity] or 1
		total += w
		table.insert(pool, { Id = id, W = w })
	end
	table.sort(pool, function(a, b)
		return a.Id < b.Id
	end)
	local r = math.random() * total
	for _, entry in pool do
		r -= entry.W
		if r <= 0 then
			return entry.Id
		end
	end
	return pool[#pool].Id
end

local function buyFruit(player)
	local data = PlayerService.Get(player)
	if not data or not nearRole(player, "Fruit") then
		return
	end
	if data.Beli < Config.FruitPrice then
		PlayerService.Notify(player, "벨리가 부족합니다.", RED)
		return
	end
	data.Beli -= Config.FruitPrice
	local id = rollFruit()
	local fruit = Config.Fruits[id]
	local old = data.Fruit and Config.Fruits[data.Fruit]
	data.Fruit = id
	PlayerService.GiveTools(player)
	PlayerService.Notify(
		player,
		string.format("[%s] %s 획득!%s", Config.RarityNames[fruit.Rarity], fruit.Name, old and (" (" .. old.Name .. " 교체됨)") or ""),
		Config.RarityColors[fruit.Rarity]
	)
	PlayerService.Sync(player)
	Remotes.OpenShop:FireClient(player, "FruitResult", id)
end

---------------------------------------------------------------------------
-- 검 상점
---------------------------------------------------------------------------
local function buySword(player, id)
	local data = PlayerService.Get(player)
	local sword = type(id) == "string" and Config.Swords[id]
	if not data or not sword or not nearRole(player, "Sword") then
		return
	end
	if table.find(data.Swords, id) then
		PlayerService.Notify(player, "이미 가지고 있는 검입니다.", RED)
		return
	end
	if data.Beli < sword.Price then
		PlayerService.Notify(player, "벨리가 부족합니다.", RED)
		return
	end
	data.Beli -= sword.Price
	table.insert(data.Swords, id)
	PlayerService.GiveTools(player)
	PlayerService.Notify(player, sword.Name .. " 구매 완료!", GREEN)
	PlayerService.Sync(player)
end

---------------------------------------------------------------------------
-- 섬 이동
---------------------------------------------------------------------------
local function travel(player, islandId)
	local data = PlayerService.Get(player)
	local island = type(islandId) == "string" and Config.IslandById[islandId]
	local char = player.Character
	if not data or not island or not char or not nearRole(player, "Travel") then
		return
	end
	if data.Level < island.Level then
		PlayerService.Notify(player, string.format("%s은(는) Lv.%d부터 갈 수 있습니다.", island.Name, island.Level), RED)
		return
	end
	local spawns = Service.World.Spawns
	char:PivotTo(spawns[island.Id] * CFrame.new(math.random(-6, 6), 0, math.random(-6, 6)))
	PlayerService.Notify(player, island.Name .. "에 도착했습니다!", Color3.fromRGB(120, 220, 255))
end

---------------------------------------------------------------------------
function Service.Init(world)
	Service.World = world
	npcs = world.NPCs
	for _, npc in npcs do
		npc.Prompt.Triggered:Connect(function(player)
			if npc.Role == "Quest" then
				Service.RequestQuest(player, npc.Island)
			elseif npc.Role == "Fruit" then
				Remotes.OpenShop:FireClient(player, "Fruit")
			elseif npc.Role == "Sword" then
				Remotes.OpenShop:FireClient(player, "Sword")
			elseif npc.Role == "Travel" then
				Remotes.OpenShop:FireClient(player, "Travel")
			end
		end)
	end
	Remotes.BuyFruit.OnServerEvent:Connect(buyFruit)
	Remotes.BuySword.OnServerEvent:Connect(buySword)
	Remotes.Travel.OnServerEvent:Connect(travel)
end

return Service
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000000D"><Properties><string name="Name">Rig</string><ProtectedString name="Source"><![CDATA[-- NPC/적 캐릭터 모델 생성 (R15 기본 아바타, 실패 시 블록 리그)

local Players = game:GetService("Players")

local Rig = {}

local cache = {}

local function blockRig(opts)
	local model = Instance.new("Model")
	local function block(name, size, color)
		local p = Instance.new("Part")
		p.Name = name
		p.Size = size
		p.Color = color
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		p.Parent = model
		return p
	end
	local root = block("HumanoidRootPart", Vector3.new(2, 2, 1), opts.Shirt)
	root.Transparency = 1
	local parts = {
		[block("Torso", Vector3.new(2, 2, 1), opts.Shirt)] = CFrame.new(),
		[block("Head", Vector3.new(2, 1, 1), opts.Skin)] = CFrame.new(0, 1.5, 0),
		[block("Left Arm", Vector3.new(1, 2, 1), opts.Skin)] = CFrame.new(-1.5, 0, 0),
		[block("Right Arm", Vector3.new(1, 2, 1), opts.Skin)] = CFrame.new(1.5, 0, 0),
		[block("Left Leg", Vector3.new(1, 2, 1), opts.Pants)] = CFrame.new(-0.5, -2, 0),
		[block("Right Leg", Vector3.new(1, 2, 1), opts.Pants)] = CFrame.new(0.5, -2, 0),
	}
	for p, offset in parts do
		p.CFrame = root.CFrame * offset
		local weld = Instance.new("Weld")
		weld.Part0 = root
		weld.Part1 = p
		weld.C0 = offset
		weld.Parent = p
	end
	local hum = Instance.new("Humanoid")
	hum.RigType = Enum.HumanoidRigType.R6
	hum.RequiresNeck = false
	hum.Parent = model
	model.PrimaryPart = root
	return model
end

local function r15Rig(opts)
	local desc = Instance.new("HumanoidDescription")
	desc.HeadColor = opts.Skin
	desc.LeftArmColor = opts.Skin
	desc.RightArmColor = opts.Skin
	desc.TorsoColor = opts.Shirt
	desc.LeftLegColor = opts.Pants
	desc.RightLegColor = opts.Pants
	return Players:CreateHumanoidModelFromDescription(desc, Enum.HumanoidRigType.R15)
end

-- key: 캐시 키, opts: {Skin, Shirt, Pants, Scale}
function Rig.Create(key, opts)
	if not cache[key] then
		local ok, model = pcall(r15Rig, opts)
		if not ok or not model then
			warn("[Rig] R15 생성 실패, 블록 리그 사용:", model)
			model = blockRig(opts)
		end
		if opts.Scale and opts.Scale ~= 1 then
			pcall(function()
				model:ScaleTo(opts.Scale)
			end)
		end
		local hum = model:FindFirstChildOfClass("Humanoid")
		hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
		hum.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
		-- 기본 Animate 스크립트 등은 제거 (서버에서 직접 애니메이션)
		for _, child in model:GetChildren() do
			if child:IsA("Script") or child:IsA("LocalScript") then
				child:Destroy()
			end
		end
		model.Name = key
		cache[key] = model
	end
	return cache[key]:Clone()
end

-- 발이 groundPos에 닿도록 배치할 때의 루트 높이
function Rig.RootHeight(model)
	local hum = model:FindFirstChildOfClass("Humanoid")
	local root = model:FindFirstChild("HumanoidRootPart")
	if hum.RigType == Enum.HumanoidRigType.R6 then
		return 3
	end
	return hum.HipHeight + root.Size.Y / 2
end

-- 머리 위 이름표 (+선택적 체력바)
function Rig.Nameplate(model, text, color, withHealth)
	local head = model:FindFirstChild("Head") or model.PrimaryPart
	local bb = Instance.new("BillboardGui")
	bb.Name = "Nameplate"
	bb.Size = UDim2.fromOffset(200, withHealth and 46 or 30)
	bb.StudsOffset = Vector3.new(0, 2.6, 0)
	bb.MaxDistance = 120
	bb.AlwaysOnTop = false
	bb.Adornee = head

	local label = Instance.new("TextLabel")
	label.Name = "Title"
	label.BackgroundTransparency = 1
	label.Size = UDim2.new(1, 0, 0, 26)
	label.Font = Enum.Font.GothamBold
	label.TextScaled = true
	label.Text = text
	label.TextColor3 = color or Color3.new(1, 1, 1)
	label.TextStrokeTransparency = 0.3
	label.Parent = bb

	if withHealth then
		local back = Instance.new("Frame")
		back.Name = "HealthBack"
		back.Position = UDim2.new(0.1, 0, 0, 30)
		back.Size = UDim2.new(0.8, 0, 0, 10)
		back.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
		back.BorderSizePixel = 0
		back.Parent = bb
		local fill = Instance.new("Frame")
		fill.Name = "Fill"
		fill.Size = UDim2.fromScale(1, 1)
		fill.BackgroundColor3 = Color3.fromRGB(80, 220, 90)
		fill.BorderSizePixel = 0
		fill.Parent = back
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0, 4)
		corner.Parent = back
		corner:Clone().Parent = fill
	end

	bb.Parent = head
	return bb
end

return Rig
]]></ProtectedString></Properties></Item>
</Item>
</Item>
<Item class="StarterPlayer" referent="RBX00000012"><Properties><string name="Name">StarterPlayer</string></Properties><Item class="StarterPlayerScripts" referent="RBX00000011"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="LocalScript" referent="RBX00000010"><Properties><string name="Name">Client</string><ProtectedString name="Source"><![CDATA[-- 오션 레거시 클라이언트: UI, 입력(공격/스킬/대시/이단점프), 상점 창

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local Debris = game:GetService("Debris")

local player = Players.LocalPlayer
local mouse = player:GetMouse()
local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
