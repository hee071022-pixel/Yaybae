local function toggleStats(force)
	if force ~= nil then
		statWindow.Visible = force
	else
		statWindow.Visible = not statWindow.Visible
	end
end
statButton.MouseButton1Click:Connect(function()
	toggleStats()
end)
closeStats.MouseButton1Click:Connect(function()
	toggleStats(false)
end)

