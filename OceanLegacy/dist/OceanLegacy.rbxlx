	Gorilla = { Name = "고릴라", Level = 22, Island = "Jungle", Count = 6, Scale = 1.3, Skin = C(60, 60, 60), Shirt = C(40, 40, 40), Pants = C(40, 40, 40) },
	GorillaKing = {
