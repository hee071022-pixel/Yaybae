	-- 해군 요새
	Marine = { Name = "해군", Level = 105, Island = "Marine", Count = 7, Skin = C(234, 184, 146), Shirt = C(245, 245, 245), Pants = C(30, 60, 140) },
	MarineCaptain = {
		Name = "해군 대령",
		Level = 125,
		Island = "Marine",
		Count = 6,
		Scale = 1.15,
