{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "haul:watcher",
      "materials": {
        "default": "entity_emissive_alpha"
      },
      "textures": {
        "default": "textures/entity/watcher"
      },
      "geometry": {
        "default": "geometry.haul.watcher"
      },
      "animations": {
        "walk": "animation.haul.walk",
        "idle": "animation.haul.watcher_idle",
        "look": "animation.haul.look",
        "attack": "animation.haul.attack"
      },
      "scripts": {
        "animate": [
          "walk",
          "idle",
          "look",
          {
            "attack": "variable.attack_time > 0"
          }
        ]
      },
      "render_controllers": [
        "controller.render.default"
      ],
      "spawn_egg": {
        "base_color": "#1d1d24",
        "overlay_color": "#e9e4d0"
      }
    }
  }
}
